# Copy this value into your local .env or export it in the pytest process.
# The database must exist and its name must end with `_test`.
TEST_DATABASE_URL=postgresql+psycopg://gjob_user:change-me@localhost:5433/gjob_db_test

# Local Qwen3 generation is independent from the existing bge-m3 embeddings.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_LLM_TIMEOUT_SECONDS=165
OLLAMA_LLM_NUM_CTX=10240
OLLAMA_LLM_NUM_PREDICT=4608
OLLAMA_LLM_SAFETY_MARGIN=256
CV_EXTRACTION_TOTAL_TIMEOUT_SECONDS=230
CV_EXTRACTION_CORRECTION_MIN_SECONDS=60
CV_EXTRACTION_NETWORK_MARGIN_SECONDS=20

# SePay contract-test placeholders. Never commit real webhook or bank credentials.
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_NAME=
SEPAY_BANK_BIN=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_PAYMENT_CODE_PREFIX=GJOB
PAYMENT_ORDER_TTL_MINUTES=30
