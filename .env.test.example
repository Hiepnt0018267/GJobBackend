# Copy this value into your local .env or export it in the pytest process.
# The database must exist and its name must end with `_test`.
TEST_DATABASE_URL=postgresql+psycopg://gjob_user:change-me@localhost:5433/gjob_db_test

# Local Qwen3 generation is independent from the existing bge-m3 embeddings.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_LLM_TIMEOUT_SECONDS=90
OLLAMA_LLM_NUM_CTX=8192
